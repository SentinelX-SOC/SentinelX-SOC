# Copy to `.env` and fill in local values. Never commit real secrets.

# --- Application ---
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=3600

# --- Local admin bootstrap ---
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_DEV_PASSWORD=change-this-development-password

# --- Password reset ---
# When true, the request-reset API may include a local reset_url for testing.
# Production must keep this false so reset tokens are never returned in JSON.
PASSWORD_RESET_DEV_MODE=false
PASSWORD_RESET_TTL_SECONDS=3600

# --- Google OAuth (authorization-code flow) ---
# Create credentials in Google Cloud Console. Redirect URI must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
OAUTH_STATE_TTL_SECONDS=600
